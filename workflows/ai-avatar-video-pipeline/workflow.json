        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 24px; background: #f9f9f9; border-radius: 12px;\">\n  <h1 style=\"color: #1a1a1a; font-size: 24px; margin-bottom: 8px;\">🎬 Your Video is Ready!</h1>\n  <p style=\"color: #555; font-size: 16px; margin-bottom: 24px;\">Your AI-generated talking video has been created successfully.</p>\n  <div style=\"background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; border-left: 4px solid #6366f1;\">\n    <p style=\"margin: 0; color: #888; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Topic</p>\n    <p style=\"margin: 6px 0 0; color: #1a1a1a; font-size: 16px; font-weight: bold;\">{{ $('Enter Video Topic').item.json['What is this video about?'] }}</p>\n  </div>\n  <div style=\"background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; border-left: 4px solid #22c55e;\">\n    <p style=\"margin: 0; color: #888; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Your Script</p>\n    <p style=\"margin: 6px 0 0; color: #333; font-size: 15px; line-height: 1.6; font-style: italic;\">\"{{ $('Self-Critique & Rewrite Script').item.json.output }}\"</p>\n  </div>\n  <a href=\"{{ $('Generate Talking Video (VEED Fabric 1.0)').item.json.video.url }}\" style=\"display: block; background: #6366f1; color: white; text-align: center; padding: 16px 24px; border-radius: 8px; font-size: 18px; font-weight: bold; text-decoration: none; margin-bottom: 20px;\">&#9654; Watch Your Video</a>\n  <p style=\"color: #aaa; font-size: 13px; text-align: center;\">Made with VEED Fabric 1.0 + n8n &middot; No camera. No filming. Just automation.</p>\n</div>",
