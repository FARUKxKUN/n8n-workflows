    {
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "=Renewal Review: {{ $json.SubscriptionName }} ({{ $json.DaysUntilRenewal }} days out)",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width:600px; margin:0 auto;\">\n  <div style=\"background-color:{{ $json.StatusColor }}; color:#ffffff; padding:16px 20px; border-radius:6px 6px 0 0;\">\n    <h2 style=\"margin:0; font-size:18px;\">{{ $json.StatusLabel }}</h2>\n  </div>\n  <div style=\"border:1px solid #e0e0e0; border-top:none; padding:20px; background:#ffffff;\">\n    <table style=\"width:100%; border-collapse:collapse; margin-bottom:16px;\">\n      <tr><td style=\"padding:6px 0; color:#555;\">Subscription</td><td style=\"padding:6px 0; font-weight:bold;\">{{ $json.SubscriptionName }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Owner</td><td style=\"padding:6px 0;\">{{ $json.OwnerName }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Renews In</td><td style=\"padding:6px 0;\">{{ $json.DaysUntilRenewal }} days</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Monthly Cost</td><td style=\"padding:6px 0;\">${{ $json.MonthlyCost }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Utilization</td><td style=\"padding:6px 0;\">{{ $json.UtilizationPct }}%</td></tr>\n    </table>\n    <div style=\"background:#f7f7f7; border-left:4px solid {{ $json.StatusColor }}; padding:12px 16px; border-radius:4px; margin-bottom:16px;\">\n      <p style=\"margin:0; color:#333; line-height:1.5;\">{{ $json.EmailBody }}</p>\n    </div>\n    <p style=\"color:#888; font-size:12px; margin:0;\">Automatically sent via n8n — Subscription & SaaS Renewal Auditor</p>\n  </div>\n</div>",
        "options": {
          "ccList": "={{ $json.OwnerEmail }}"
        }
      },
