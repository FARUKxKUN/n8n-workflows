            },
            {
              "id": "a9",
              "name": "DaysUntilRenewal",
              "type": "number",
              "value": "={{ Math.ceil((new Date($json.RenewalDate) - new Date()) / 86400000) }}"
            },
            {
              "id": "a10",
              "name": "DaysSinceLastUsed",
              "type": "number",
              "value": "={{ Math.floor((new Date() - new Date($json.LastUsedDate)) / 86400000) }}"
            },
            {
              "id": "a11",
              "name": "UtilizationPct",
              "type": "number",
              "value": "={{ $json.LicensedSeats > 0 ? Math.round(($json.ActiveUsers / $json.LicensedSeats) * 100) : 0 }}"
            },
            {
              "id": "a12",
              "name": "IsUnused",
              "type": "boolean",
              "value": "={{ $json.ActiveUsers === 0 || (Math.floor((new Date() - new Date($json.LastUsedDate)) / 86400000)) > 45 }}"
            },
            {
              "id": "a13",
              "name": "IsValidData",
              "type": "boolean",
              "value": "={{ !isNaN(new Date($json.RenewalDate).getTime()) && !isNaN(new Date($json.LastUsedDate).getTime()) && !isNaN(Number($json.ActiveUsers)) && Number($json.ActiveUsers) >= 0 && !isNaN(Number($json.LicensedSeats)) && Number($json.LicensedSeats) > 0 && $json.OwnerEmail !== '' && $json.OwnerEmail !== undefined }}"
            }
          ]
        },
