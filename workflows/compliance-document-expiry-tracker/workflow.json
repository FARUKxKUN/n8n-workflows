            },
            {
              "name": "daysUntilExpiry",
              "type": "number",
              "value": "={{ Math.ceil((new Date($json.ExpiryDate) - new Date()) / (1000*60*60*24)) }}",
              "id": "cb9d8a0e-0cf5-4f96-8567-aba3e5301510"
            }
