              "id": "a7",
              "name": "OvertimeLimit",
              "type": "number",
              "value": 45
            },
            {
              "id": "a8",
              "name": "OvertimeHours",
              "type": "number",
              "value": "={{ Math.max(0, $json.sum_HoursWorked - 40) }}"
            },
            {
              "id": "a9",
              "name": "ThresholdStatus",
              "type": "string",
              "value": "={{ $json.sum_HoursWorked > 45 ? 'violation' : ($json.sum_HoursWorked > 40 ? 'approaching' : 'compliant') }}"
            },
            {
              "id": "a10",
              "name": "WeekStamp",
              "type": "string",
              "value": "={{ $now.toFormat(\"kkkk-'W'WW\") }}"
            },
            {
              "id": "a11",
              "name": "IsValidData",
              "type": "boolean",
              "value": "={{ $json.sum_HoursWorked > 0 && $json.sum_HoursWorked <= 168 && $json.EmployeeEmail !== '' && $json.ManagerEmail !== '' }}"
            }
          ]
        },
        "options": {}
      },
